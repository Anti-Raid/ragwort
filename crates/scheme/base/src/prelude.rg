; The prelude: the base language's procedures, as the module ragwort/prelude, around the VM's
; built-ins. Helpers are bound around the procedure that uses them, so they're made once and named
; by none.

(%provide (all-defined-out))

(%define car (%lambda (pair) (%intrinsic car pair)))
(%define cdr (%lambda (pair) (%intrinsic cdr pair)))
(%define cons (%lambda (a d) (%intrinsic cons a d)))
(%define caar (%lambda (x) (%intrinsic caar x)))
(%define cadr (%lambda (x) (%intrinsic cadr x)))
(%define cdar (%lambda (x) (%intrinsic cdar x)))
(%define cddr (%lambda (x) (%intrinsic cddr x)))
(%define caaar (%lambda (x) (%intrinsic caaar x)))
(%define caadr (%lambda (x) (%intrinsic caadr x)))
(%define cadar (%lambda (x) (%intrinsic cadar x)))
(%define caddr (%lambda (x) (%intrinsic caddr x)))
(%define cdaar (%lambda (x) (%intrinsic cdaar x)))
(%define cdadr (%lambda (x) (%intrinsic cdadr x)))
(%define cddar (%lambda (x) (%intrinsic cddar x)))
(%define cdddr (%lambda (x) (%intrinsic cdddr x)))
(%define caaaar (%lambda (x) (%intrinsic caaaar x)))
(%define caaadr (%lambda (x) (%intrinsic caaadr x)))
(%define caadar (%lambda (x) (%intrinsic caadar x)))
(%define caaddr (%lambda (x) (%intrinsic caaddr x)))
(%define cadaar (%lambda (x) (%intrinsic cadaar x)))
(%define cadadr (%lambda (x) (%intrinsic cadadr x)))
(%define caddar (%lambda (x) (%intrinsic caddar x)))
(%define cadddr (%lambda (x) (%intrinsic cadddr x)))
(%define cdaaar (%lambda (x) (%intrinsic cdaaar x)))
(%define cdaadr (%lambda (x) (%intrinsic cdaadr x)))
(%define cdadar (%lambda (x) (%intrinsic cdadar x)))
(%define cdaddr (%lambda (x) (%intrinsic cdaddr x)))
(%define cddaar (%lambda (x) (%intrinsic cddaar x)))
(%define cddadr (%lambda (x) (%intrinsic cddadr x)))
(%define cdddar (%lambda (x) (%intrinsic cdddar x)))
(%define cddddr (%lambda (x) (%intrinsic cddddr x)))
(%define eq? (%lambda (a b) (%intrinsic eq? a b)))
(%define eqv? (%lambda (a b) (%intrinsic eqv? a b)))
(%define equal? (%lambda (a b) (%intrinsic equal? a b)))
(%define not (%lambda (x) (%intrinsic not x)))
(%define boolean? (%lambda (x) (%intrinsic boolean? x)))
(%define procedure? (%lambda (x) (%intrinsic procedure? x)))
(%define continuation? (%lambda (x) (%intrinsic continuation? x)))
(%define void (%lambda args (%intrinsic void)))

(%define box (%lambda (x) (%intrinsic box x)))
(%define box? (%lambda (x) (%intrinsic box? x)))
(%define unbox (%lambda (b) (%intrinsic unbox b)))
(%define set-box! (%lambda (b x) (%intrinsic set-box! b x)))

(%define bytevector? (%lambda (x) (%intrinsic bytevector? x)))
(%define make-bytevector (%lambda (k . fill) (%apply-intrinsic make-bytevector k fill)))
(%define bytevector-length (%lambda (bv) (%intrinsic bytevector-length bv)))
(%define bytevector-u8-ref (%lambda (bv k) (%intrinsic bytevector-u8-ref bv k)))
(%define bytevector-u8-set! (%lambda (bv k byte) (%intrinsic bytevector-u8-set! bv k byte)))

(%define vector? (%lambda (x) (%intrinsic vector? x)))
(%define make-vector (%lambda (k . fill) (%apply-intrinsic make-vector k fill)))
(%define vector (%lambda xs (%apply-intrinsic vector xs)))
(%define vector-length (%lambda (v) (%intrinsic vector-length v)))
(%define vector-ref (%lambda (v k) (%intrinsic vector-ref v k)))
(%define vector-set! (%lambda (v k x) (%intrinsic vector-set! v k x)))
(%define vector->list (%lambda (v) (%intrinsic vector->list v)))
(%define list->vector (%lambda (xs) (%intrinsic list->vector xs)))

(%define + (%lambda xs (%apply-intrinsic + xs)))
(%define - (%lambda xs (%apply-intrinsic - xs)))
(%define * (%lambda xs (%apply-intrinsic * xs)))
(%define / (%lambda xs (%apply-intrinsic / xs)))
(%define = (%lambda (x . xs) (%apply-intrinsic = x xs)))
(%define < (%lambda (x . xs) (%apply-intrinsic < x xs)))
(%define > (%lambda (x . xs) (%apply-intrinsic > x xs)))
(%define <= (%lambda (x . xs) (%apply-intrinsic <= x xs)))
(%define >= (%lambda (x . xs) (%apply-intrinsic >= x xs)))
(%define expt (%lambda (z w) (%intrinsic expt z w)))
(%define quotient (%lambda (n m) (%intrinsic quotient n m)))
(%define remainder (%lambda (n m) (%intrinsic remainder n m)))
(%define modulo (%lambda (n m) (%intrinsic modulo n m)))
(%define bitwise-and (%lambda ns (%apply-intrinsic bitwise-and ns)))
(%define bitwise-ior (%lambda ns (%apply-intrinsic bitwise-ior ns)))
(%define bitwise-xor (%lambda ns (%apply-intrinsic bitwise-xor ns)))
(%define bitwise-not (%lambda (n) (%intrinsic bitwise-not n)))
(%define arithmetic-shift (%lambda (n count) (%intrinsic arithmetic-shift n count)))
(%define integer-length (%lambda (n) (%intrinsic integer-length n)))
(%define bit-count (%lambda (n) (%intrinsic bit-count n)))
(%define bit-set? (%lambda (index n) (%intrinsic bit-set? index n)))
(%define bit-field (%lambda (n start end) (%intrinsic bit-field n start end)))
(%define bit-field-replace (%lambda (dest source start end) (%intrinsic bit-field-replace dest source start end)))
(%define add1 (%lambda (z) (%intrinsic + z 1)))
(%define sub1 (%lambda (z) (%intrinsic + z -1)))

(%define apply (%lambda (f . args) (%apply-intrinsic apply f args)))
(%define keyword-apply (%lambda (f kws vals . args) (%apply-intrinsic keyword-apply f kws vals args)))
(%define procedure-keywords (%lambda (f) (%intrinsic procedure-keywords f)))
(%define values (%lambda xs (%apply-intrinsic values xs)))
(%define call-with-values
  (%lambda (producer consumer)
    (%intrinsic apply-values consumer (%app producer))))

(%define default-continuation-prompt-tag (%lambda () (%intrinsic default-continuation-prompt-tag)))
(%define make-continuation-prompt-tag (%lambda args (%apply-intrinsic make-continuation-prompt-tag args)))
(%define call-with-composable-continuation
  (%lambda (f . more)
    (%if (%intrinsic null? more)
         (%intrinsic capture (%intrinsic default-continuation-prompt-tag) f)
         (%if (%intrinsic null? (%intrinsic cdr more))
              (%intrinsic capture (%intrinsic car more) f)
              (%intrinsic apply call-with-composable-continuation '())))))
(%define call-with-continuation-prompt
  (%letrec ((handler (%lambda (thunk)
                       (%intrinsic call-with-prompt (%intrinsic default-continuation-prompt-tag) handler thunk))))
    (%lambda (proc . more)
      (%if (%intrinsic null? more)
           (%intrinsic call-with-prompt (%intrinsic default-continuation-prompt-tag) handler proc)
           (%let ((tag (%intrinsic car more)) (rest (%intrinsic cdr more)))
             (%if (%intrinsic null? rest)
                  (%intrinsic call-with-prompt tag handler proc)
                  (%let ((h (%intrinsic car rest)) (args (%intrinsic cdr rest)))
                    (%apply-intrinsic call-with-prompt tag h proc args))))))))

; dynamic-wind is Chez's: it sets the task's winders around the thunk, and a jump out of or into
; their extent, which the VM runs, runs a winder's after or before. call/cc and exceptions are the
; VM's, and VM faults are raised as error objects.
; Marks, as Racket's continuation marks: `thunk` is called with `key` marked `value`, which a
; call in tail position replaces, and `mark-value` is the nearest mark for `key`, or `default`.
(%define call-with-mark (%lambda (key value thunk) (%intrinsic with-mark key value thunk)))
(%define mark-value (%lambda (key default) (%intrinsic mark-value key default)))

(%define dynamic-wind
  (%lambda (before thunk after)
    (%let* ((_ (%app before))
            (outside (%intrinsic winders))
            (_ (%intrinsic set-winders! (%intrinsic cons (%intrinsic make-winder before after) outside)))
            (result (%app thunk))
            (_ (%intrinsic set-winders! outside)))
      (%app after)
      result)))
(%define abort-current-continuation (%lambda (tag . args) (%apply-intrinsic abort tag args)))
(%define call/cc (%lambda (f) (%intrinsic call/cc f)))
(%define call-with-current-continuation (%lambda (f) (%intrinsic call/cc f)))

(%define with-exception-handler (%lambda (handler thunk) (%intrinsic with-exception-handler handler thunk)))
(%define raise (%lambda (obj) (%intrinsic raise obj)))
(%define raise-continuable (%lambda (obj) (%intrinsic raise-continuable obj)))
(%define error (%lambda (message . irritants) (%intrinsic raise (%apply-intrinsic make-error message irritants))))
(%define keyword? (%lambda (x) (%intrinsic keyword? x)))
(%define keyword->string (%lambda (k) (%intrinsic keyword->string k)))
(%define string->keyword (%lambda (s) (%intrinsic string->keyword s)))
(%define symbol? (%lambda (x) (%intrinsic symbol? x)))
(%define string? (%lambda (x) (%intrinsic string? x)))
(%define string-length (%lambda (s) (%intrinsic string-length s)))
(%define string-append (%lambda xs (%apply-intrinsic string-append xs)))
(%define substring (%lambda (s start . end) (%apply-intrinsic substring s start end)))
(%define string-ref (%lambda (s k) (%intrinsic string-ref s k)))
(%define string=? (%lambda (s . ss) (%apply-intrinsic string=? s ss)))
(%define string<? (%lambda (s . ss) (%apply-intrinsic string<? s ss)))
(%define string>? (%lambda (s . ss) (%apply-intrinsic string>? s ss)))
(%define string<=? (%lambda (s . ss) (%apply-intrinsic string<=? s ss)))
(%define string>=? (%lambda (s . ss) (%apply-intrinsic string>=? s ss)))
(%define string->list (%lambda (s . range) (%apply-intrinsic string->list s range)))
(%define number->string (%lambda (z . radix) (%apply-intrinsic number->string z radix)))
(%define string-join (%lambda (strs . sep) (%apply-intrinsic string-join strs sep)))
(%define char? (%lambda (x) (%intrinsic char? x)))
(%define char->integer (%lambda (c) (%intrinsic char->integer c)))
(%define integer->char (%lambda (n) (%intrinsic integer->char n)))
(%define char=? (%lambda (c . cs) (%apply-intrinsic char=? c cs)))
(%define char<? (%lambda (c . cs) (%apply-intrinsic char<? c cs)))
(%define char>? (%lambda (c . cs) (%apply-intrinsic char>? c cs)))
(%define char<=? (%lambda (c . cs) (%apply-intrinsic char<=? c cs)))
(%define char>=? (%lambda (c . cs) (%apply-intrinsic char>=? c cs)))
(%define symbol->string (%lambda (s) (%intrinsic symbol->string s)))
(%define string->symbol (%lambda (s) (%intrinsic string->symbol s)))
(%define error-object? (%lambda (x) (%intrinsic error-object? x)))
(%define error-object-message (%lambda (c) (%intrinsic error-object-message c)))
(%define error-object-irritants (%lambda (c) (%intrinsic error-object-irritants c)))
(%define error-object-kind
  (%lambda (c)
    (%intrinsic vector-ref
      #(malformed out-of-memory wrong-type out-of-range immutable arity not-procedure no-prompt unbound finished
        out-of-fuel error not-pending divide-by-zero no-exact-value not-integer too-long syntax keyword)
      (%intrinsic error-object-kind c))))
; What `guard` expands to: `thunk`, and if it raises, `handler` in its place, with what it raised.
(%define %guard (%lambda (thunk handler) (%intrinsic guard thunk handler)))

(%define make-coroutine (%lambda (f) (%intrinsic make-coroutine f)))
(%define coroutine? (%lambda (x) (%intrinsic coroutine? x)))
(%define co/resume (%lambda (co . args) (%apply-intrinsic co/resume co args)))
(%define co/try-resume (%lambda (co . args) (%apply-intrinsic co/try-resume co args)))
(%define co/yield (%lambda args (%apply-intrinsic co/yield args)))
(%define co/running (%lambda () (%intrinsic co/running)))
(%define co/status
  (%lambda (co) (%intrinsic vector-ref #(pending running finished error) (%intrinsic coroutine-state co))))

(%define null? (%lambda (x) (%intrinsic null? x)))
(%define pair? (%lambda (x) (%intrinsic pair? x)))
(%define list (%lambda xs xs))
(%define list? (%lambda (x) (%intrinsic list? x)))
(%define length (%lambda (xs) (%intrinsic length xs)))
(%define reverse (%lambda (xs) (%intrinsic reverse xs)))
(%define append (%lambda lists (%apply-intrinsic append lists)))
(%define list-tail (%lambda (xs k) (%intrinsic list-tail xs k)))
(%define list-ref (%lambda (xs k) (%intrinsic list-ref xs k)))

(%define memq (%lambda (x xs) (%intrinsic memq x xs)))
(%define memv (%lambda (x xs) (%intrinsic memv x xs)))
(%define member (%lambda (x xs) (%intrinsic member x xs)))
(%define assq (%lambda (x xs) (%intrinsic assq x xs)))
(%define assv (%lambda (x xs) (%intrinsic assv x xs)))
(%define assoc (%lambda (x xs) (%intrinsic assoc x xs)))

(%define map
  (%letrec ((map1 (%lambda (f xs)
                    (%if (%intrinsic null? xs) '() (%intrinsic cons (%app f (%intrinsic car xs)) (%app map1 f (%intrinsic cdr xs))))))
            (any-null? (%lambda (ls)
                         (%if (%intrinsic null? ls) #f (%if (%intrinsic null? (%intrinsic car ls)) #t (%app any-null? (%intrinsic cdr ls))))))
            (cars (%lambda (ls) (%app map1 (%lambda (l) (%intrinsic car l)) ls)))
            (cdrs (%lambda (ls) (%app map1 (%lambda (l) (%intrinsic cdr l)) ls)))
            (mapn (%lambda (f ls)
                    (%if (%app any-null? ls) '() (%intrinsic cons (%intrinsic apply f (%app cars ls)) (%app mapn f (%app cdrs ls)))))))
    (%lambda (f xs . more)
      (%if (%intrinsic null? more) (%app map1 f xs) (%app mapn f (%intrinsic cons xs more))))))
(%define for-each
  (%letrec ((each1 (%lambda (f xs)
                     (%if (%intrinsic null? xs)
                          (%intrinsic void)
                          (%let ((_ (%app f (%intrinsic car xs)))) (%app each1 f (%intrinsic cdr xs)))))))
    (%lambda (f xs . more)
      (%if (%intrinsic null? more)
           (%app each1 f xs)
           (%let ((_ (%intrinsic apply map f xs more))) (%intrinsic void))))))

; Syntax objects, for macros' transformers and any other code: the expander says what each
; identifier it makes refers to, so these need nothing of it.
(%define syntax? (%lambda (x) (%intrinsic syntax? x)))
(%define identifier? (%lambda (x) (%intrinsic identifier? x)))
(%define syntax-e (%lambda (stx) (%intrinsic syntax-e stx)))
(%define syntax->datum (%lambda (stx) (%intrinsic syntax->datum stx)))
(%define datum->syntax (%lambda (context datum) (%intrinsic datum->syntax context datum)))
(%define bound-identifier=? (%lambda (a b) (%intrinsic bound-identifier=? a b)))
(%define syntax->list
  (%lambda (stx)
    (%let ((e (%if (%intrinsic syntax? stx) (%intrinsic syntax-e stx) stx)))
      (%if (%intrinsic list? e) e #f))))
(%define free-identifier=? (%lambda (a b) (%intrinsic free-identifier=? a b)))
(%define generate-temporaries (%lambda (xs) (%intrinsic generate-temporaries xs (%quote t))))
(%define syntax-violation
  (%lambda (who message form . subform)
    (%intrinsic raise (%apply-intrinsic make-syntax-error message form subform))))
