(%define unbox (%lambda (b) (%intrinsic unbox b)))
(%define set-box! (%lambda (b x) (%intrinsic set-box! b x)))

(%define bytevector? (%lambda (x) (%intrinsic bytevector? x)))
(%define make-bytevector (%lambda (k . fill) (%apply-intrinsic make-bytevector k fill)))
(%define bytevector-length (%lambda (bv) (%intrinsic bytevector-length bv)))
; The bytes from k as an integer of so many bytes, signed or not, little- or big-endian.
(%define bytevector-u8-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f 1)))
(%define bytevector-u8-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f 1)))
(%define bytevector-s8-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f -1)))
(%define bytevector-s8-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f -1)))
(%define bytevector-u16le-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f 2)))
(%define bytevector-u16le-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f 2)))
(%define bytevector-u16be-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #t 2)))
(%define bytevector-u16be-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #t 2)))
(%define bytevector-s16le-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f -2)))
(%define bytevector-s16le-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f -2)))
(%define bytevector-s16be-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #t -2)))
(%define bytevector-s16be-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #t -2)))
(%define bytevector-u32le-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f 4)))
(%define bytevector-u32le-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f 4)))
(%define bytevector-u32be-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #t 4)))
(%define bytevector-u32be-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #t 4)))
(%define bytevector-s32le-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f -4)))
(%define bytevector-s32le-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f -4)))
(%define bytevector-s32be-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #t -4)))
(%define bytevector-s32be-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #t -4)))
(%define bytevector-u64le-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f 8)))
(%define bytevector-u64le-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f 8)))
(%define bytevector-u64be-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #t 8)))
(%define bytevector-u64be-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #t 8)))
(%define bytevector-s64le-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #f -8)))
(%define bytevector-s64le-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #f -8)))
(%define bytevector-s64be-ref (%lambda (bv k) (%intrinsic bytevector-int-ref bv k #t -8)))
(%define bytevector-s64be-set! (%lambda (bv k n) (%intrinsic bytevector-int-set! bv k n #t -8)))

(%define vector? (%lambda (x) (%intrinsic vector? x)))
(%define make-vector (%lambda (k . fill) (%apply-intrinsic make-vector k fill)))
(%define vector (%lambda xs (%apply-intrinsic vector xs)))
(%define vector-length (%lambda (v) (%intrinsic vector-length v)))
(%define vector-ref (%lambda (v k) (%intrinsic vector-ref v k)))
(%define vector-set! (%lambda (v k x) (%intrinsic vector-set! v k x)))
(%define vector->list (%lambda (v) (%intrinsic vector->list v)))
(%define list->vector (%lambda (xs) (%intrinsic list->vector xs)))

(%define + (%lambda xs (%apply-intrinsic + xs)))
(%define - (%lambda xs (%apply-intrinsic - xs)))
(%define * (%lambda xs (%apply-intrinsic * xs)))
(%define / (%lambda xs (%apply-intrinsic / xs)))
(%define = (%lambda (x . xs) (%apply-intrinsic = x xs)))
(%define < (%lambda (x . xs) (%apply-intrinsic < x xs)))
(%define > (%lambda (x . xs) (%apply-intrinsic > x xs)))
(%define <= (%lambda (x . xs) (%apply-intrinsic <= x xs)))
(%define >= (%lambda (x . xs) (%apply-intrinsic >= x xs)))
(%define expt (%lambda (z w) (%intrinsic expt z w)))
(%define quotient (%lambda (n m) (%intrinsic quotient n m)))
(%define remainder (%lambda (n m) (%intrinsic remainder n m)))
(%define modulo (%lambda (n m) (%intrinsic modulo n m)))
(%define bitwise-and (%lambda ns (%apply-intrinsic bitwise-and ns)))
(%define bitwise-ior (%lambda ns (%apply-intrinsic bitwise-ior ns)))
(%define bitwise-xor (%lambda ns (%apply-intrinsic bitwise-xor ns)))
(%define bitwise-not (%lambda (n) (%intrinsic bitwise-not n)))
(%define arithmetic-shift (%lambda (n count) (%intrinsic arithmetic-shift n count)))
(%define integer-length (%lambda (n) (%intrinsic integer-length n)))
(%define bit-count (%lambda (n) (%intrinsic bit-count n)))
(%define bit-set? (%lambda (index n) (%intrinsic bit-set? index n)))
(%define bit-field (%lambda (n start end) (%intrinsic bit-field n start end)))
; `n` as a `width`-bit unsigned integer, shifted `count` bits with zeros shifted in.
(%define logical-shift-right
  (%lambda (n count width)
    (%if (%intrinsic >= count width)
         (%intrinsic bit-field (%intrinsic bit-field n count count) width width)
         (%intrinsic bit-field n count width))))
(%define logical-shift-left
  (%lambda (n count width)
    (%if (%intrinsic >= count width)
         (%intrinsic bit-field (%intrinsic bit-field n count count) width width)
         (%if (%intrinsic < count 0)
              (%intrinsic bit-field n count width)
              (%intrinsic arithmetic-shift (%intrinsic bit-field n 0 (%intrinsic - width count)) count)))))
(%define bit-field-replace (%lambda (dest source start end) (%intrinsic bit-field-replace dest source start end)))
(%define add1 (%lambda (z) (%intrinsic + z 1)))
(%define sub1 (%lambda (z) (%intrinsic + z -1)))

(%define apply (%lambda (f . args) (%apply-intrinsic apply f args)))
(%define keyword-apply (%lambda (f kws vals . args) (%apply-intrinsic keyword-apply f kws vals args)))
(%define procedure-keywords (%lambda (f) (%intrinsic procedure-keywords f)))
(%define values (%lambda xs (%apply-intrinsic values xs)))
(%define call-with-values
  (%lambda (producer consumer)
    (%intrinsic apply-values consumer (%app producer))))

(%define default-continuation-prompt-tag (%lambda () (%intrinsic default-continuation-prompt-tag)))
(%define make-continuation-prompt-tag (%lambda args (%apply-intrinsic make-continuation-prompt-tag args)))
(%define call-with-composable-continuation
  (%lambda (f . more)
    (%if (%intrinsic null? more)
         (%intrinsic capture (%intrinsic default-continuation-prompt-tag) f)
         (%if (%intrinsic null? (%intrinsic cdr more))
              (%intrinsic capture (%intrinsic car more) f)
              (%intrinsic apply call-with-composable-continuation '())))))
(%define call-with-continuation-prompt
  (%letrec ((handler (%lambda (thunk)
                       (%intrinsic call-with-prompt (%intrinsic default-continuation-prompt-tag) handler thunk))))
    (%lambda (proc . more)
      (%if (%intrinsic null? more)
           (%intrinsic call-with-prompt (%intrinsic default-continuation-prompt-tag) handler proc)
           (%let ((tag (%intrinsic car more)) (rest (%intrinsic cdr more)))
             (%if (%intrinsic null? rest)
                  (%intrinsic call-with-prompt tag handler proc)
                  (%let ((h (%intrinsic car rest)) (args (%intrinsic cdr rest)))
                    (%apply-intrinsic call-with-prompt tag h proc args))))))))

; dynamic-wind is Chez's: it sets the task's winders around the thunk, and a jump out of or into
; their extent, which the VM runs, runs a winder's after or before. call/cc and exceptions are the
; VM's, and VM faults are raised as error objects.
; Marks, as Racket's continuation marks: `thunk` is called with `key` marked `value`, which a
; call in tail position replaces, and `mark-value` is the nearest mark for `key`, or `default`.
(%define call-with-mark (%lambda (key value thunk) (%intrinsic with-mark key value thunk)))
(%define mark-value (%lambda (key default) (%intrinsic mark-value key default)))

(%define dynamic-wind
  (%lambda (before thunk after)
    (%let* ((_ (%app before))
            (outside (%intrinsic winders))
            (_ (%intrinsic set-winders! (%intrinsic cons (%intrinsic make-winder before after) outside)))
            (result (%app thunk))
            (_ (%intrinsic set-winders! outside)))
      (%app after)
      result)))
(%define abort-current-continuation (%lambda (tag . args) (%apply-intrinsic abort tag args)))
(%define call/cc (%lambda (f) (%intrinsic call/cc f)))
(%define call-with-current-continuation (%lambda (f) (%intrinsic call/cc f)))

(%define with-exception-handler (%lambda (handler thunk) (%intrinsic with-exception-handler handler thunk)))
(%define raise (%lambda (obj) (%intrinsic raise obj)))
(%define raise-continuable (%lambda (obj) (%intrinsic raise-continuable obj)))
(%define error (%lambda (message . irritants) (%intrinsic raise (%apply-intrinsic make-error message irritants))))
(%define keyword? (%lambda (x) (%intrinsic keyword? x)))
(%define keyword->string (%lambda (k) (%intrinsic keyword->string k)))
(%define string->keyword (%lambda (s) (%intrinsic string->keyword s)))
(%define symbol? (%lambda (x) (%intrinsic symbol? x)))
(%define string? (%lambda (x) (%intrinsic string? x)))
(%define string-length (%lambda (s) (%intrinsic string-length s)))
(%define string-append (%lambda xs (%apply-intrinsic string-append xs)))
(%define substring (%lambda (s start . end) (%apply-intrinsic substring s start end)))
(%define string-ref (%lambda (s k) (%intrinsic string-ref s k)))
(%define string=? (%lambda (s . ss) (%apply-intrinsic string=? s ss)))
(%define string<? (%lambda (s . ss) (%apply-intrinsic string<? s ss)))
(%define string>? (%lambda (s . ss) (%apply-intrinsic string>? s ss)))
(%define string<=? (%lambda (s . ss) (%apply-intrinsic string<=? s ss)))
(%define string>=? (%lambda (s . ss) (%apply-intrinsic string>=? s ss)))
(%define string->list (%lambda (s . range) (%apply-intrinsic string->list s range)))
(%define number->string (%lambda (z . radix) (%apply-intrinsic number->string z radix)))
(%define string-join (%lambda (strs . sep) (%apply-intrinsic string-join strs sep)))
(%define char? (%lambda (x) (%intrinsic char? x)))
(%define char->integer (%lambda (c) (%intrinsic char->integer c)))
(%define integer->char (%lambda (n) (%intrinsic integer->char n)))
(%define char=? (%lambda (c . cs) (%apply-intrinsic char=? c cs)))
(%define char<? (%lambda (c . cs) (%apply-intrinsic char<? c cs)))
(%define char>? (%lambda (c . cs) (%apply-intrinsic char>? c cs)))
(%define char<=? (%lambda (c . cs) (%apply-intrinsic char<=? c cs)))
(%define char>=? (%lambda (c . cs) (%apply-intrinsic char>=? c cs)))
(%define symbol->string (%lambda (s) (%intrinsic symbol->string s)))
(%define string->symbol (%lambda (s) (%intrinsic string->symbol s)))
(%define error-object? (%lambda (x) (%intrinsic error-object? x)))
(%define error-object-message (%lambda (c) (%intrinsic error-object-message c)))
(%define error-object-irritants (%lambda (c) (%intrinsic error-object-irritants c)))
(%define error-object-kind (%lambda (c) (%intrinsic error-object-kind c)))
; What `guard` expands to: `thunk`, and if it raises, `handler` in its place, with what it raised.
(%define %guard (%lambda (thunk handler) (%intrinsic guard thunk handler)))

(%define make-coroutine (%lambda (f) (%intrinsic make-coroutine f)))
(%define coroutine? (%lambda (x) (%intrinsic coroutine? x)))
(%define co/resume (%lambda (co . args) (%apply-intrinsic co/resume co args)))
(%define co/try-resume (%lambda (co . args) (%apply-intrinsic co/try-resume co args)))
(%define co/yield (%lambda args (%apply-intrinsic co/yield args)))
(%define co/running (%lambda () (%intrinsic co/running)))
(%define co/status
  (%lambda (co) (%intrinsic vector-ref #(pending running finished error) (%intrinsic coroutine-state co))))

(%define null? (%lambda (x) (%intrinsic null? x)))
(%define pair? (%lambda (x) (%intrinsic pair? x)))
(%define list (%lambda xs xs))
(%define list? (%lambda (x) (%intrinsic list? x)))
(%define length (%lambda (xs) (%intrinsic length xs)))
(%define reverse (%lambda (xs) (%intrinsic reverse xs)))
(%define append (%lambda lists (%apply-intrinsic append lists)))
(%define list-tail (%lambda (xs k) (%intrinsic list-tail xs k)))
(%define list-ref (%lambda (xs k) (%intrinsic list-ref xs k)))

(%define memq (%lambda (x xs) (%intrinsic memq x xs)))
(%define memv (%lambda (x xs) (%intrinsic memv x xs)))
(%define member (%lambda (x xs) (%intrinsic member x xs)))
(%define assq (%lambda (x xs) (%intrinsic assq x xs)))
(%define assv (%lambda (x xs) (%intrinsic assv x xs)))
(%define assoc (%lambda (x xs) (%intrinsic assoc x xs)))

(%define map
  (%letrec ((map1 (%lambda (f xs)
                    (%if (%intrinsic null? xs) '() (%intrinsic cons (%app f (%intrinsic car xs)) (%app map1 f (%intrinsic cdr xs))))))
            (any-null? (%lambda (ls)
                         (%if (%intrinsic null? ls) #f (%if (%intrinsic null? (%intrinsic car ls)) #t (%app any-null? (%intrinsic cdr ls))))))
            (cars (%lambda (ls) (%app map1 (%lambda (l) (%intrinsic car l)) ls)))
            (cdrs (%lambda (ls) (%app map1 (%lambda (l) (%intrinsic cdr l)) ls)))
            (mapn (%lambda (f ls)
                    (%if (%app any-null? ls) '() (%intrinsic cons (%intrinsic apply f (%app cars ls)) (%app mapn f (%app cdrs ls)))))))
    (%lambda (f xs . more)
      (%if (%intrinsic null? more) (%app map1 f xs) (%app mapn f (%intrinsic cons xs more))))))
(%define for-each
  (%letrec ((each1 (%lambda (f xs)
                     (%if (%intrinsic null? xs)
                          (%intrinsic void)
                          (%let ((_ (%app f (%intrinsic car xs)))) (%app each1 f (%intrinsic cdr xs)))))))
    (%lambda (f xs . more)
      (%if (%intrinsic null? more)
           (%app each1 f xs)
           (%let ((_ (%intrinsic apply map f xs more))) (%intrinsic void))))))

; Syntax objects, for macros' transformers and any other code: the expander says what each
; identifier it makes refers to, so these need nothing of it.
(%define syntax? (%lambda (x) (%intrinsic syntax? x)))
(%define identifier? (%lambda (x) (%intrinsic identifier? x)))
(%define syntax-e (%lambda (stx) (%intrinsic syntax-e stx)))
(%define syntax->datum (%lambda (stx) (%intrinsic syntax->datum stx)))
(%define datum->syntax (%lambda (context datum) (%intrinsic datum->syntax context datum)))
(%define bound-identifier=? (%lambda (a b) (%intrinsic bound-identifier=? a b)))
(%define syntax->list
  (%lambda (stx)
    (%let ((e (%if (%intrinsic syntax? stx) (%intrinsic syntax-e stx) stx)))
      (%if (%intrinsic list? e) e #f))))
(%define free-identifier=? (%lambda (a b) (%intrinsic free-identifier=? a b)))
(%define generate-temporaries (%lambda (xs) (%intrinsic generate-temporaries xs (%quote t))))
(%define syntax-violation
  (%lambda (who message form . subform)
    (%intrinsic raise (%apply-intrinsic make-syntax-error message form subform))))

; Number related methods
(%define number? (%lambda (x) (%intrinsic number? x)))
(%define complex? (%lambda (x) (%intrinsic number? x)))
(%define real? (%lambda (x) (%intrinsic real? x)))
(%define rational? (%lambda (x) (%intrinsic rational? x)))
(%define integer? (%lambda (x) (%intrinsic integer? x)))
(%define exact-integer? (%lambda (x) (%intrinsic exact-integer? x)))
(%define exact? (%lambda (z) (%intrinsic exact? z)))
(%define inexact? (%lambda (z) (%intrinsic inexact? z)))
(%define nan? (%lambda (z) (%intrinsic nan? z)))
(%define infinite? (%lambda (z) (%intrinsic infinite? z)))
(%define finite? (%lambda (z) (%intrinsic finite? z)))
(%define zero? (%lambda (z) (%intrinsic zero? z)))
(%define positive? (%lambda (x) (%intrinsic positive? x)))
(%define negative? (%lambda (x) (%intrinsic negative? x)))
(%define odd? (%lambda (n) (%intrinsic odd? n)))
(%define even? (%lambda (n) (%intrinsic even? n)))
(%define max (%lambda (x . xs) (%apply-intrinsic max x xs)))
(%define min (%lambda (x . xs) (%apply-intrinsic min x xs)))
(%define abs (%lambda (x) (%intrinsic abs x)))
(%define gcd (%lambda ns (%apply-intrinsic gcd ns)))
(%define lcm (%lambda ns (%apply-intrinsic lcm ns)))
(%define numerator (%lambda (x) (%intrinsic numerator x)))
(%define denominator (%lambda (x) (%intrinsic denominator x)))
(%define floor (%lambda (x) (%intrinsic floor x)))
(%define ceiling (%lambda (x) (%intrinsic ceiling x)))
(%define truncate (%lambda (x) (%intrinsic truncate x)))
(%define round (%lambda (x) (%intrinsic round x)))
(%define floor-quotient (%lambda (n m) (%intrinsic floor-quotient n m)))
(%define floor-remainder (%lambda (n m) (%intrinsic modulo n m)))
(%define floor/ (%lambda (n m) (%intrinsic values (%intrinsic floor-quotient n m) (%intrinsic modulo n m))))
(%define truncate-quotient (%lambda (n m) (%intrinsic quotient n m)))
(%define truncate-remainder (%lambda (n m) (%intrinsic remainder n m)))
(%define truncate/ (%lambda (n m) (%intrinsic values (%intrinsic quotient n m) (%intrinsic remainder n m))))
(%define integer-sqrt (%lambda (n) (%intrinsic integer-sqrt n)))
; The root and what's left of n past its square.
(%define exact-integer-sqrt
  (%lambda (n)
    (%let ((s (%intrinsic integer-sqrt n)))
      (%intrinsic values s (%intrinsic - n (%intrinsic * s s))))))
(%define square (%lambda (z) (%intrinsic * z z)))
(%define exact (%lambda (z) (%intrinsic exact z)))
(%define inexact (%lambda (z) (%intrinsic inexact z)))
(%define inexact->exact (%lambda (z) (%intrinsic exact z)))
(%define exact->inexact (%lambda (z) (%intrinsic inexact z)))
(%define string->number (%lambda (s . radix) (%apply-intrinsic string->number s radix)))
(%define exp (%lambda (z) (%intrinsic exp z)))
(%define log (%lambda (z . base) (%apply-intrinsic log z base)))
(%define sin (%lambda (z) (%intrinsic sin z)))
(%define cos (%lambda (z) (%intrinsic cos z)))
(%define tan (%lambda (z) (%intrinsic tan z)))
(%define asin (%lambda (z) (%intrinsic asin z)))
(%define acos (%lambda (z) (%intrinsic acos z)))
(%define atan (%lambda (z . x) (%apply-intrinsic atan z x)))
(%define sqrt (%lambda (z) (%intrinsic sqrt z)))
(%define make-rectangular (%lambda (x y) (%intrinsic make-rectangular x y)))
(%define make-polar (%lambda (m a) (%intrinsic make-polar m a)))
(%define real-part (%lambda (z) (%intrinsic real-part z)))
(%define imag-part (%lambda (z) (%intrinsic imag-part z)))
(%define magnitude (%lambda (z) (%intrinsic magnitude z)))
(%define angle (%lambda (z) (%intrinsic angle z)))

; Characters and strings, past the basic ones.
(%define char-alphabetic? (%lambda (c) (%intrinsic char-alphabetic? c)))
(%define char-numeric? (%lambda (c) (%intrinsic char-numeric? c)))
(%define char-whitespace? (%lambda (c) (%intrinsic char-whitespace? c)))
(%define char-upper-case? (%lambda (c) (%intrinsic char-upper-case? c)))
(%define char-lower-case? (%lambda (c) (%intrinsic char-lower-case? c)))
(%define digit-value (%lambda (c) (%intrinsic digit-value c)))
(%define char-upcase (%lambda (c) (%intrinsic char-upcase c)))
(%define char-downcase (%lambda (c) (%intrinsic char-downcase c)))
(%define char-foldcase (%lambda (c) (%intrinsic char-foldcase c)))
(%define char-ci=? (%lambda (c . cs) (%apply-intrinsic char-ci=? c cs)))
(%define char-ci<? (%lambda (c . cs) (%apply-intrinsic char-ci<? c cs)))
(%define char-ci>? (%lambda (c . cs) (%apply-intrinsic char-ci>? c cs)))
(%define char-ci<=? (%lambda (c . cs) (%apply-intrinsic char-ci<=? c cs)))
(%define char-ci>=? (%lambda (c . cs) (%apply-intrinsic char-ci>=? c cs)))
(%define make-string (%lambda (k . c) (%apply-intrinsic make-string k c)))
(%define string (%lambda cs (%intrinsic list->string cs)))
(%define list->string (%lambda (cs) (%intrinsic list->string cs)))
(%define string-upcase (%lambda (s) (%intrinsic string-upcase s)))
(%define string-downcase (%lambda (s) (%intrinsic string-downcase s)))
(%define string-foldcase (%lambda (s) (%intrinsic string-foldcase s)))
(%define string-ci=? (%lambda (s . ss) (%apply-intrinsic string-ci=? s ss)))
(%define string-ci<? (%lambda (s . ss) (%apply-intrinsic string-ci<? s ss)))
(%define string-ci>? (%lambda (s . ss) (%apply-intrinsic string-ci>? s ss)))
(%define string-ci<=? (%lambda (s . ss) (%apply-intrinsic string-ci<=? s ss)))
(%define string-ci>=? (%lambda (s . ss) (%apply-intrinsic string-ci>=? s ss)))
(%define string->vector (%lambda (s . range) (%apply-intrinsic string->vector s range)))
(%define vector->string (%lambda (v . range) (%apply-intrinsic vector->string v range)))
(%define string->utf8 (%lambda (s . range) (%apply-intrinsic string->utf8 s range)))
(%define utf8->string (%lambda (bv . range) (%apply-intrinsic utf8->string bv range)))
; The characters `f` makes of those of the strings, as `map` makes them of lists.
(%define string-map
  (%lambda (f s . more)
    (%if (%intrinsic null? more)
         (%intrinsic list->string (%app map f (%intrinsic string->list s)))
         (%intrinsic list->string (%intrinsic apply map f (%intrinsic string->list s) (%app map string->list more))))))
(%define string-for-each
  (%lambda (f s . more)
    (%if (%intrinsic null? more)
         (%app for-each f (%intrinsic string->list s))
         (%intrinsic apply for-each f (%intrinsic string->list s) (%app map string->list more)))))
(%define string-prefix? (%lambda (s prefix) (%intrinsic string-prefix? s prefix)))
(%define string-suffix? (%lambda (s suffix) (%intrinsic string-suffix? s suffix)))
(%define string-contains? (%lambda (s part) (%intrinsic string-contains? s part)))
; As Racket's: `sep` is a string, or #f for whitespace.
(%define string-split
  (%lambda (s [sep #f] #:trim? [trim? #t] #:repeat? [repeat? #f])
    (%intrinsic string-split s sep trim? repeat?)))
(%define string-trim
  (%lambda (s [sep #f] #:left? [left? #t] #:right? [right? #t] #:repeat? [repeat? #f])
    (%intrinsic string-trim s sep left? right? repeat?)))
(%define string-replace (%lambda (s from to #:all? [all? #t]) (%intrinsic string-replace s from to all?)))
(%define string-find (%lambda (s part . start) (%apply-intrinsic string-find s part start)))
(%define string-find-last (%lambda (s part . end) (%apply-intrinsic string-find-last s part end)))

; Structs by their types, which `match` and `struct-copy` are made of. A field's index is where
; its name is in what `struct-fields` lists.
; A struct of a type with guards: each guarded field's guard has to accept its value.
(%define make-guarded-struct
  (%lambda (type fields)
    (%let ((made (%apply-intrinsic make-struct type fields)))
      (%letrec ((check (%lambda (values k)
                         (%if (%intrinsic null? values)
                              made
                              (%let ((guard (%intrinsic struct-field-guard type k)) (value (%intrinsic car values)))
                                (%if guard
                                     (%if (%app guard value) #f (%intrinsic raise (%intrinsic make-struct-guard-error type k value)))
                                     #f)
                                (%app check (%intrinsic cdr values) (%intrinsic + k 1)))))))
        (%app check fields 0)))))
; Calls of this with a type that has no guards make the struct themselves.
(%define make-struct
  (%lambda (type . fields)
    (%if (%intrinsic struct-guarded? type) (%app make-guarded-struct type fields) (%apply-intrinsic make-struct type fields))))
(%define struct-derived-from? (%lambda (v type) (%intrinsic struct-derived-from? v type)))
(%define struct-ref (%lambda (s type k) (%intrinsic struct-ref s type k)))
(%define struct-fields (%lambda (type) (%intrinsic struct-fields type)))
; Sets a guarded field, if its guard accepts the value.
(%define set-guarded-struct-field!
  (%lambda (s type k v)
    (%if (%app (%intrinsic struct-field-guard type k) v) #f (%intrinsic raise (%intrinsic make-struct-guard-error type k v)))
    (%intrinsic struct-set! s type k v)))
; Calls of this for a field with no guard set the field themselves.
(%define struct-set!
  (%lambda (s type k v)
    (%if (%intrinsic struct-field-guarded? type k) (%app set-guarded-struct-field! s type k v) (%intrinsic struct-set! s type k v))))
(%define struct-field-mutable? (%lambda (type k) (%intrinsic struct-field-mutable? type k)))
(%define struct? (%lambda (v) (%intrinsic struct? v)))
(%define struct-type? (%lambda (v) (%intrinsic struct-type? v)))
(%define struct-guarded? (%lambda (type) (%intrinsic struct-guarded? type)))
(%define struct-field-guard (%lambda (type k) (%intrinsic struct-field-guard type k)))
(%define struct-set-field-guard! (%lambda (type k guard) (%intrinsic struct-set-field-guard! type k guard)))
(%define make-struct-guard-error (%lambda (type k v) (%intrinsic make-struct-guard-error type k v)))
