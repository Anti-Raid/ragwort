; The prelude: the base language's procedures, as globals around the VM's built-ins.
; Helpers are bound around the procedure that uses them, so they're made once and named by none.

(%define-global car (%lambda (pair) (%intrinsic car pair)))
(%define-global cdr (%lambda (pair) (%intrinsic cdr pair)))
(%define-global cons (%lambda (a d) (%intrinsic cons a d)))
(%define-global caar (%lambda (x) (%intrinsic caar x)))
(%define-global cadr (%lambda (x) (%intrinsic cadr x)))
(%define-global cdar (%lambda (x) (%intrinsic cdar x)))
(%define-global cddr (%lambda (x) (%intrinsic cddr x)))
(%define-global caaar (%lambda (x) (%intrinsic caaar x)))
(%define-global caadr (%lambda (x) (%intrinsic caadr x)))
(%define-global cadar (%lambda (x) (%intrinsic cadar x)))
(%define-global caddr (%lambda (x) (%intrinsic caddr x)))
(%define-global cdaar (%lambda (x) (%intrinsic cdaar x)))
(%define-global cdadr (%lambda (x) (%intrinsic cdadr x)))
(%define-global cddar (%lambda (x) (%intrinsic cddar x)))
(%define-global cdddr (%lambda (x) (%intrinsic cdddr x)))
(%define-global caaaar (%lambda (x) (%intrinsic caaaar x)))
(%define-global caaadr (%lambda (x) (%intrinsic caaadr x)))
(%define-global caadar (%lambda (x) (%intrinsic caadar x)))
(%define-global caaddr (%lambda (x) (%intrinsic caaddr x)))
(%define-global cadaar (%lambda (x) (%intrinsic cadaar x)))
(%define-global cadadr (%lambda (x) (%intrinsic cadadr x)))
(%define-global caddar (%lambda (x) (%intrinsic caddar x)))
(%define-global cadddr (%lambda (x) (%intrinsic cadddr x)))
(%define-global cdaaar (%lambda (x) (%intrinsic cdaaar x)))
(%define-global cdaadr (%lambda (x) (%intrinsic cdaadr x)))
(%define-global cdadar (%lambda (x) (%intrinsic cdadar x)))
(%define-global cdaddr (%lambda (x) (%intrinsic cdaddr x)))
(%define-global cddaar (%lambda (x) (%intrinsic cddaar x)))
(%define-global cddadr (%lambda (x) (%intrinsic cddadr x)))
(%define-global cdddar (%lambda (x) (%intrinsic cdddar x)))
(%define-global cddddr (%lambda (x) (%intrinsic cddddr x)))
(%define-global eq? (%lambda (a b) (%intrinsic eq? a b)))
(%define-global eqv? (%lambda (a b) (%intrinsic eqv? a b)))
(%define-global equal? (%lambda (a b) (%intrinsic equal? a b)))
(%define-global not (%lambda (x) (%intrinsic not x)))
(%define-global boolean? (%lambda (x) (%intrinsic boolean? x)))
(%define-global procedure? (%lambda (x) (%intrinsic procedure? x)))
(%define-global continuation? (%lambda (x) (%intrinsic continuation? x)))
(%define-global void (%lambda args (%intrinsic void)))

(%define-global box (%lambda (x) (%intrinsic box x)))
(%define-global box? (%lambda (x) (%intrinsic box? x)))
(%define-global unbox (%lambda (b) (%intrinsic unbox b)))
(%define-global set-box! (%lambda (b x) (%intrinsic set-box! b x)))

(%define-global bytevector? (%lambda (x) (%intrinsic bytevector? x)))
(%define-global make-bytevector (%lambda (k . fill) (%apply-intrinsic make-bytevector k fill)))
(%define-global bytevector-length (%lambda (bv) (%intrinsic bytevector-length bv)))
(%define-global bytevector-u8-ref (%lambda (bv k) (%intrinsic bytevector-u8-ref bv k)))
(%define-global bytevector-u8-set! (%lambda (bv k byte) (%intrinsic bytevector-u8-set! bv k byte)))

(%define-global vector? (%lambda (x) (%intrinsic vector? x)))
(%define-global make-vector (%lambda (k . fill) (%apply-intrinsic make-vector k fill)))
(%define-global vector (%lambda xs (%apply-intrinsic vector xs)))
(%define-global vector-length (%lambda (v) (%intrinsic vector-length v)))
(%define-global vector-ref (%lambda (v k) (%intrinsic vector-ref v k)))
(%define-global vector-set! (%lambda (v k x) (%intrinsic vector-set! v k x)))
(%define-global vector->list (%lambda (v) (%intrinsic vector->list v)))
(%define-global list->vector (%lambda (xs) (%intrinsic list->vector xs)))

(%define-global + (%lambda xs (%apply-intrinsic + xs)))
(%define-global - (%lambda xs (%apply-intrinsic - xs)))
(%define-global * (%lambda xs (%apply-intrinsic * xs)))
(%define-global / (%lambda xs (%apply-intrinsic / xs)))
(%define-global add1 (%lambda (z) (%intrinsic + z 1)))
(%define-global sub1 (%lambda (z) (%intrinsic + z -1)))

(%define-global apply (%lambda (f . args) (%apply-intrinsic apply f args)))
(%define-global values (%lambda xs (%apply-intrinsic values xs)))
(%define-global call-with-values
  (%lambda (producer consumer)
    (%intrinsic apply-values consumer (%app producer))))

(%define-global default-continuation-prompt-tag (%lambda () (%intrinsic default-continuation-prompt-tag)))
(%define-global make-continuation-prompt-tag (%lambda args (%apply-intrinsic make-continuation-prompt-tag args)))
(%define-global abort-current-continuation (%lambda (tag . args) (%apply-intrinsic abort tag args)))
(%define-global call-with-composable-continuation
  (%lambda (f . more)
    (%if (%intrinsic null? more)
         (%intrinsic capture (%intrinsic default-continuation-prompt-tag) f)
         (%if (%intrinsic null? (%intrinsic cdr more))
              (%intrinsic capture (%intrinsic car more) f)
              (%intrinsic apply call-with-composable-continuation '())))))
(%define-global call-with-continuation-prompt
  (%letrec ((handler (%lambda (thunk)
                       (%intrinsic call-with-prompt (%intrinsic default-continuation-prompt-tag) handler thunk))))
    (%lambda (proc . more)
      (%if (%intrinsic null? more)
           (%intrinsic call-with-prompt (%intrinsic default-continuation-prompt-tag) handler proc)
           (%let ((tag (%intrinsic car more)) (rest (%intrinsic cdr more)))
             (%if (%intrinsic null? rest)
                  (%intrinsic call-with-prompt tag handler proc)
                  (%let ((h (%intrinsic car rest)) (args (%intrinsic cdr rest)))
                    (%apply-intrinsic call-with-prompt tag h proc args))))))))
(%define-global call/cc
  (%lambda (f)
    (%intrinsic capture (%intrinsic default-continuation-prompt-tag)
      (%lambda (k)
        (%app f (%lambda args
                  (%intrinsic abort (%intrinsic default-continuation-prompt-tag)
                    (%lambda () (%intrinsic apply k args)))))))))
(%define-global call-with-current-continuation
  (%lambda (f)
    (%intrinsic capture (%intrinsic default-continuation-prompt-tag)
      (%lambda (k)
        (%app f (%lambda args
                  (%intrinsic abort (%intrinsic default-continuation-prompt-tag)
                    (%lambda () (%intrinsic apply k args)))))))))

(%define-global make-coroutine (%lambda (f) (%intrinsic make-coroutine f)))
(%define-global coroutine? (%lambda (x) (%intrinsic coroutine? x)))
(%define-global co/resume (%lambda (co . args) (%apply-intrinsic co/resume co args)))
(%define-global co/try-resume (%lambda (co . args) (%apply-intrinsic co/try-resume co args)))
(%define-global co/yield (%lambda args (%apply-intrinsic co/yield args)))
(%define-global co/running (%lambda () (%intrinsic co/running)))
(%define-global co/status
  (%lambda (co) (%intrinsic vector-ref #(pending running finished error) (%intrinsic coroutine-state co))))

(%define-global null? (%lambda (x) (%intrinsic null? x)))
(%define-global pair? (%lambda (x) (%intrinsic pair? x)))
(%define-global list (%lambda xs xs))
(%define-global list? (%lambda (x) (%intrinsic list? x)))
(%define-global length (%lambda (xs) (%intrinsic length xs)))
(%define-global reverse (%lambda (xs) (%intrinsic reverse xs)))
(%define-global append (%lambda lists (%apply-intrinsic append lists)))
(%define-global list-tail (%lambda (xs k) (%intrinsic list-tail xs k)))
(%define-global list-ref (%lambda (xs k) (%intrinsic list-ref xs k)))

(%define-global memq (%lambda (x xs) (%intrinsic memq x xs)))
(%define-global memv (%lambda (x xs) (%intrinsic memv x xs)))
(%define-global member (%lambda (x xs) (%intrinsic member x xs)))
(%define-global assq (%lambda (x xs) (%intrinsic assq x xs)))
(%define-global assv (%lambda (x xs) (%intrinsic assv x xs)))
(%define-global assoc (%lambda (x xs) (%intrinsic assoc x xs)))

(%define-global map
  (%letrec ((map1 (%lambda (f xs)
                    (%if (%intrinsic null? xs) '() (%intrinsic cons (%app f (%intrinsic car xs)) (%app map1 f (%intrinsic cdr xs))))))
            (any-null? (%lambda (ls)
                         (%if (%intrinsic null? ls) #f (%if (%intrinsic null? (%intrinsic car ls)) #t (%app any-null? (%intrinsic cdr ls))))))
            (cars (%lambda (ls) (%app map1 (%lambda (l) (%intrinsic car l)) ls)))
            (cdrs (%lambda (ls) (%app map1 (%lambda (l) (%intrinsic cdr l)) ls)))
            (mapn (%lambda (f ls)
                    (%if (%app any-null? ls) '() (%intrinsic cons (%intrinsic apply f (%app cars ls)) (%app mapn f (%app cdrs ls)))))))
    (%lambda (f xs . more)
      (%if (%intrinsic null? more) (%app map1 f xs) (%app mapn f (%intrinsic cons xs more))))))
(%define-global for-each
  (%letrec ((each1 (%lambda (f xs)
                     (%if (%intrinsic null? xs)
                          (%intrinsic void)
                          (%let ((_ (%app f (%intrinsic car xs)))) (%app each1 f (%intrinsic cdr xs)))))))
    (%lambda (f xs . more)
      (%if (%intrinsic null? more)
           (%app each1 f xs)
           (%let ((_ (%intrinsic apply map f xs more))) (%intrinsic void))))))
